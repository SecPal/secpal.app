import { useTranslations } from "../../i18n/index.ts";
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Hero from "../../components/Hero.astro";
import DomainFocus from "../../components/DomainFocus.astro";
import Approach from "../../components/Approach.astro";
import OpenSource from "../../components/OpenSource.astro";
import CTA from "../../components/CTA.astro";
import Footer from "../../components/Footer.astro";
---

<Base
  title="SecPal – A guard's best friend"
  description={useTranslations("de").hero.description}
  lang="de"
  canonicalPath="/de/"
>
  <Nav locale="de" transparent />
  <main class="-mt-[var(--secpal-nav-height)] pt-[var(--secpal-nav-height)]">
    <Hero locale="de" />
    <DomainFocus locale="de" />
    <Approach locale="de" />
    <OpenSource locale="de" />
    <CTA locale="de" />
  </main>
  <Footer locale="de" />
</Base>
