import type { GetStaticPaths } from "astro";
import { getLocalizedPath, locales } from "../../i18n/routing.ts";

export const getStaticPaths = (() =>
  locales.map((locale) => ({
    params: { locale },
    props: { locale },
  }))) satisfies GetStaticPaths;

return Astro.redirect(
  `${getLocalizedPath("/", Astro.props.locale)}#focus`,
  301
);
---
