import { useTranslations } from "../../i18n/index.ts";
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Hero from "../../components/Hero.astro";
import DomainFocus from "../../components/DomainFocus.astro";
import Approach from "../../components/Approach.astro";
import OpenSource from "../../components/OpenSource.astro";
import CTA from "../../components/CTA.astro";
import Footer from "../../components/Footer.astro";
---

<Base
  title="SecPal – A guard's best friend"
  description={useTranslations("en").hero.description}
  lang="en"
  canonicalPath="/en/"
>
  <Nav locale="en" transparent />
  <main class="-mt-[var(--secpal-nav-height)] pt-[var(--secpal-nav-height)]">
    <Hero locale="en" />
    <DomainFocus locale="en" />
    <Approach locale="en" />
    <OpenSource locale="en" />
    <CTA locale="en" />
  </main>
  <Footer locale="en" />
</Base>
