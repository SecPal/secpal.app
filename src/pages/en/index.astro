import { useTranslations } from "../../i18n/index.ts";
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Hero from "../../components/Hero.astro";
import Features from "../../components/Features.astro";
import Workflow from "../../components/Workflow.astro";
import Outcomes from "../../components/Outcomes.astro";
import DevelopmentStatus from "../../components/DevelopmentStatus.astro";
import CTA from "../../components/CTA.astro";
import Footer from "../../components/Footer.astro";
---

<Base
  title="SecPal – A guard's best friend"
  description={useTranslations("en").hero.description}
  lang="en"
  canonicalPath="/en/"
>
  <Nav locale="en" transparent />
  <main class="-mt-[var(--secpal-nav-height)] pt-[var(--secpal-nav-height)]">
    <Hero locale="en" />
    <Features locale="en" />
    <Workflow locale="en" />
    <Outcomes locale="en" />
    <DevelopmentStatus locale="en" />
    <CTA locale="en" />
  </main>
  <Footer locale="en" />
</Base>
