import type { Locale } from "../i18n/index.ts";
import { useTranslations, getLocalizedPath } from "../i18n/index.ts";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<footer class="bg-white dark:bg-gray-900">
  <div class="mx-auto max-w-7xl px-6 py-12 md:flex md:items-center md:justify-between lg:px-8">
    <div class="flex flex-wrap justify-center gap-x-6 gap-y-3 md:order-2">
      <a
        href={getLocalizedPath("/privacy", locale)}
        class="text-sm/6 text-gray-600 hover:text-gray-800 dark:text-gray-400 dark:hover:text-white"
      >
        {t.footer.links.privacy}
      </a>
      <a
        href={getLocalizedPath("/imprint", locale)}
        class="text-sm/6 text-gray-600 hover:text-gray-800 dark:text-gray-400 dark:hover:text-white"
      >
        {t.footer.links.imprint}
      </a>
      <a
        href={getLocalizedPath("/security", locale)}
        class="text-sm/6 text-gray-600 hover:text-gray-800 dark:text-gray-400 dark:hover:text-white"
      >
        {t.footer.links.security}
      </a>
    </div>
    <div class="mt-8 text-center text-sm/6 text-gray-600 md:order-1 md:mt-0 dark:text-gray-400">
      <p>
        <a lang="en" href="https://secpal.app" class="hover:underline">
          Powered by SecPal – A guard's best friend
        </a>
      </p>
      <p>
        <a
          href="https://www.gnu.org/licenses/agpl-3.0.html"
          class="hover:underline"
        >
          AGPL v3+
        </a>
        <span aria-hidden="true"> | </span>
        <a
          href="https://github.com/SecPal/secpal.app"
          referrerpolicy="no-referrer"
          class="hover:underline"
        >
          {t.footer.links.source}
        </a>
      </p>
    </div>
  </div>
</footer>
