// Adapted from Tailwind Plus Marketing → Content Sections → Split with image
// Local source: ~/code/tailwind-plus-components/html/marketing/page-sections/content-sections/split-with-image.html
import type { Locale } from "../i18n/index.ts";
import { useTranslations } from "../i18n/index.ts";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section
  id="open-source"
  aria-labelledby="open-source-heading"
  class="border-y border-gray-200 bg-gray-50 py-14 sm:py-20 dark:border-white/10 dark:bg-gray-800/50"
>
  <div class="mx-auto grid max-w-7xl gap-6 px-6 lg:grid-cols-5 lg:gap-x-16 lg:px-8">
    <h2
      id="open-source-heading"
      class="text-3xl font-semibold tracking-tight text-pretty text-gray-900 sm:text-4xl lg:col-span-2 dark:text-white"
    >
      {t.openSource.headline}
    </h2>
    <div class="max-w-2xl space-y-4 text-base/7 text-gray-600 lg:col-span-3 dark:text-gray-300">
      <p>{t.openSource.license}</p>
      <p>{t.openSource.hosting}</p>
    </div>
  </div>
</section>
