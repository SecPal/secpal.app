import type { Locale } from "../i18n/index.ts";
import { useTranslations } from "../i18n/index.ts";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section
  id="approach"
  aria-labelledby="approach-heading"
  class="bg-white py-14 sm:py-20 dark:bg-gray-900"
>
  <div class="mx-auto grid max-w-7xl gap-6 px-6 lg:grid-cols-5 lg:gap-x-16 lg:px-8">
    <h2
      id="approach-heading"
      class="text-3xl font-semibold tracking-tight text-pretty text-gray-900 sm:text-4xl lg:col-span-2 dark:text-white"
    >
      {t.approach.headline}
    </h2>
    <div class="max-w-2xl space-y-4 text-base/7 text-gray-600 lg:col-span-3 dark:text-gray-300">
      <p>{t.approach.purpose}</p>
      <p>{t.approach.workflows}</p>
      <p>{t.approach.data}</p>
    </div>
  </div>
</section>
