// Local source: ~/code/tailwind-plus-components/html/marketing/page-sections/content-sections/split-with-image.html
import {
  getLocalizedPath,
  type Locale,
  useTranslations,
} from "../i18n/index.ts";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const roadmapHref = getLocalizedPath("/roadmap", locale);
---

<section
  aria-labelledby="development-status-heading"
  class="border-b border-gray-200 bg-white py-20 sm:py-24 dark:border-white/10 dark:bg-gray-900"
>
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:gap-x-20">
      <div class="max-w-2xl">
        <h2
          id="development-status-heading"
          class="text-3xl font-semibold tracking-tight text-pretty text-gray-900 sm:text-4xl dark:text-white"
        >
          {t.developmentStatus.headline}
        </h2>
        <p class="mt-6 text-base/7 text-gray-600 dark:text-gray-300">
          {t.developmentStatus.introduction}
        </p>
        <ul class="mt-5 space-y-2 text-sm/6 font-semibold text-indigo-600 dark:text-indigo-400">
          <li>
            <a class="underline" href={roadmapHref}>
              {t.developmentStatus.roadmapLink}
            </a>
          </li>
          <li>
            <a
              class="underline"
              href="https://github.com/SecPal/.github/blob/main/docs/architecture.md"
            >
              {t.developmentStatus.architectureLink}
            </a>
          </li>
        </ul>
      </div>

      <div class="max-w-2xl">
        <h3 class="text-lg/8 font-semibold text-gray-900 dark:text-white">
          {t.developmentStatus.hostingTitle}
        </h3>
        <p class="mt-3 text-base/7 text-gray-600 dark:text-gray-300">
          {t.developmentStatus.hostingDescription}
        </p>
        <p class="mt-5 text-sm/6 font-semibold text-indigo-600 dark:text-indigo-400">
          <a
            class="underline"
            href="https://github.com/SecPal/deployment#readme"
          >
            {t.developmentStatus.hostingLink}
          </a>
        </p>
      </div>
    </div>
  </div>
</section>
