---
// SPDX-FileCopyrightText: 2026 SecPal
// SPDX-FileCopyrightText: Tailwind Labs Inc.
// SPDX-License-Identifier: AGPL-3.0-or-later AND LicenseRef-TailwindPlus
// Adapted from Tailwind Plus Marketing → Page Sections → Stats → Timeline
// Local source: ~/code/tailwind-plus-components/html/marketing/page-sections/stats/timeline.html
//
// Design notes:
//   - The ordered list stays vertical through tablet widths so longer German
//     and English descriptions retain a comfortable measure.
//   - At xl, the five stations share one horizontal row and the restrained
//     connector treatment from the source block.
//   - Numbered markers replace dates and make the sequence visible without
//     relying on color or decorative icons.
import type { Locale } from "../i18n/index.ts";
import { useTranslations } from "../i18n/index.ts";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section
  id="workflow"
  aria-labelledby="workflow-heading"
  class="bg-white py-20 sm:py-24 dark:bg-gray-900"
>
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="max-w-3xl">
      <p class="text-base/7 font-semibold text-indigo-600 dark:text-indigo-400">
        {t.workflow.overline}
      </p>
      <h2
        id="workflow-heading"
        class="mt-2 text-3xl font-semibold tracking-tight text-pretty text-gray-900 sm:text-4xl dark:text-white"
      >
        {t.workflow.headline}
      </h2>
      <p class="mt-6 text-base/7 text-gray-600 sm:text-lg/8 dark:text-gray-300">
        {t.workflow.introduction}
      </p>
    </div>

    <ol
      class="relative mt-14 space-y-8 before:absolute before:top-5 before:bottom-5 before:left-5 before:w-px before:bg-gray-200 sm:mt-16 xl:grid xl:grid-cols-5 xl:gap-x-6 xl:space-y-0 xl:before:hidden dark:before:bg-white/15"
    >
      {
        t.workflow.steps.map((step, index) => (
          <li class="relative grid min-w-0 grid-cols-[2.5rem_minmax(0,1fr)] gap-x-5 xl:block">
            <div class="relative z-10 flex size-10 items-center justify-center rounded-full border border-indigo-200 bg-white text-sm/6 font-semibold text-indigo-700 dark:border-indigo-400/40 dark:bg-gray-900 dark:text-indigo-300">
              <span aria-hidden="true">{index + 1}</span>
            </div>
            {index < t.workflow.steps.length - 1 && (
              <div
                aria-hidden="true"
                class="absolute top-5 left-10 hidden h-px w-[calc(100%-1rem)] bg-gray-200 xl:block dark:bg-white/15"
              />
            )}
            <div class="min-w-0 break-words pb-2 xl:mt-6 xl:pb-0 xl:pr-2">
              <h3 class="text-lg/8 font-semibold text-gray-900 dark:text-white">
                {step.name}
              </h3>
              <p class="mt-2 text-base/7 text-gray-600 dark:text-gray-400">
                {step.description}
              </p>
            </div>
          </li>
        ))
      }
    </ol>

    <p
      class="mt-14 max-w-3xl text-sm/6 text-gray-500 sm:mt-16 dark:text-gray-400"
    >
      {t.workflow.closing}
    </p>
  </div>
</section>
