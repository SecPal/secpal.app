{
  "name": "@secpal/secpal.app",
  "version": "0.0.1",
  "description": "Public website for SecPal – A guard’s best friend",
  "private": true,
  "type": "module",
  "author": "SecPal",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/SecPal/secpal.app.git"
  },
  "homepage": "https://secpal.app",
  "bugs": {
    "url": "https://github.com/SecPal/secpal.app/issues"
  },
  "keywords": [
    "secpal",
    "landing-page",
    "astro",
    "tailwindcss",
    "security",
    "security-operations",
    "built-in-public"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "npm run generate:og && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "generate:og": "node ./scripts/generate-social-previews.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "astro check",
    "format": "prettier --write --cache '**/*.{md,yml,yaml,json,ts,tsx,js,jsx,astro}'",
    "test": "node --experimental-strip-types --test tests/**/*.mjs",
    "format:check": "prettier --check '**/*.{md,yml,yaml,json,ts,tsx,js,jsx,astro}'"
  },
  "dependencies": {
    "@tailwindplus/elements": "^1.0.0",
    "astro": "^6.4.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@tailwindcss/vite": "^4.3.0",
    "@typescript-eslint/parser": "^8.61.0",
    "eslint": "^10.4.1",
    "eslint-plugin-astro": "^1.7.0",
    "prettier": "^3.8.4",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.35.1",
    "tailwindcss": "^4.3.0",
    "typescript": "6.0.x"
  },
  "overrides": {
    "anymatch": {
      "picomatch": "^2.3.2"
    },
    "brace-expansion": "^5.0.5",
    "defu": "^6.1.7",
    "micromatch": {
      "picomatch": "^2.3.2"
    },
    "picomatch": "^4.0.4",
    "vite": "^7.3.2",
    "yaml": "^2.8.3"
  }
}
